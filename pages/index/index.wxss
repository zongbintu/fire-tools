.container {
  padding: 20rpx;
}
.chart-container {
  width: 100%;
  height: 1000rpx;
  margin-bottom: 40rpx;
}
.placeholder-chart {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f0f0f0;
  color: #999999;
  font-size: 28rpx;
}
.header {
  text-align: center;
  margin-bottom: 40rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
}
.summary {
  margin-bottom: 40rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.label {
  font-weight: bold;
}
.value {
  color: #333333;
}
.buttons {
  display: flex;
  flex-direction: column;
}
button {
  margin-bottom: 20rpx;
}
/* 遮罩层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

/* 弹窗容器 */
.popup {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  max-width: 80%;
  max-height: 80%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* 图片样式 */
.poster-img {
  width: 600rpx;
  max-width: 100%;
  height: auto;
  border-radius: 8rpx;
}