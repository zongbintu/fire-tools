.container {
  padding: 20rpx;
}
.chart-container {
  width: 100%;
  height: 400rpx;
  margin-bottom: 40rpx;
}
.placeholder-chart {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f0f0f0;
  color: #999999;
  font-size: 28rpx;
}
.header {
  text-align: center;
  margin-bottom: 40rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
}
.summary {
  margin-bottom: 40rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.label {
  font-weight: bold;
}
.value {
  color: #333333;
}
.buttons {
  display: flex;
  flex-direction: column;
}
button {
  margin-bottom: 20rpx;
}
